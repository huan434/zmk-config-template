#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define FUNC  1

/ {
    chosen {
        zmk,physical-layout = &macro_layout;
    };

    macro_layout: macro_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>; 
        kscan = <&kscan0>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            // Cấu hình cho 8 phím bấm trên Pipar Flake
            bindings = <
                &kp TAB         &kp LEFT_WIN    &kp BACKSPACE   &kp UP_ARROW    
                &kp ENTER       &kp LEFT_ARROW  &kp DOWN_ARROW  &studio_unlock
            >;
            // Xoay núm để tăng/giảm âm lượng
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        function_layer {
            display-name = "function";
            // Các phím chức năng và kết nối Bluetooth, chuyển về layer default
            bindings = <
                &bt BT_CLR    &none         &bt BT_SEL 0  &bt BT_SEL 1  
                &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to BASE
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
